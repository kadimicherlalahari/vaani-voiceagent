{
  "name": "aangan-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "start": "tsx --env-file=../.env src/index.ts",
    "agent:sync": "tsx --env-file=../.env src/scripts/syncAgent.ts",
    "seed": "tsx --env-file=../.env src/scripts/seed.ts",
    "simulate": "tsx --env-file=../.env src/scripts/simulate.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "google:auth": "tsx --env-file=../.env src/scripts/googleAuth.ts",
    "telegram:setup": "tsx --env-file=../.env src/scripts/telegramSetup.ts",
    "check": "tsx --env-file=../.env src/scripts/check.ts",
    "vercel:env": "tsx --env-file=../.env src/scripts/pushEnv.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/functions": "^3.9.11",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
